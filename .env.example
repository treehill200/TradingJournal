# ---------------------------------------------------------------------------
# Trading Journal configuration
# Copy to .env.local for development, or set these in your host's dashboard.
# ---------------------------------------------------------------------------

# Where the database lives.
#
#   Local / VPS / Docker (a real file on disk, the default):
#     DATABASE_URL="file:./data/journal.db"
#
#   Serverless (Vercel, Netlify) with Turso — same SQL, hosted:
#     DATABASE_URL="libsql://your-database-name.turso.io"
#     DATABASE_AUTH_TOKEN="your-turso-token"
DATABASE_URL="file:./data/journal.db"
# DATABASE_AUTH_TOKEN=""

# Set to "false" to close public registration after you have made your own
# account — useful when the site is publicly reachable but only you should be
# able to sign up. Existing users can still sign in.
ALLOW_SIGNUPS="true"
